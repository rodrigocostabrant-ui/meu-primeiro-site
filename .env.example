# Número real do WhatsApp da Visiva, apenas dígitos, com DDI + DDD.
# Ex.: 55 11 91234-5678 -> 5511912345678
# Enquanto vazio, todos os botões de WhatsApp do site ficam desabilitados
# (em vez de apontar para um número inventado).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública real do site (domínio próprio ou o gerado pela Vercel),
# usada em metadata/SEO/OpenGraph.
NEXT_PUBLIC_SITE_URL=
